# Concert Monitor Configuration
# Copy this file to .env and fill in your values

# Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Ticketmaster API
# Get your API key at: https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=
TICKETMASTER_API_SECRET=

# SeatGeek API
# Get your credentials at: https://seatgeek.com/account/develop
SEATGEEK_CLIENT_ID=
SEATGEEK_CLIENT_SECRET=

# Spotify API
# Create an app at: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Apple Music API (requires Apple Developer account)
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY=

# Google Calendar API
# Set up credentials at: https://console.cloud.google.com/
# Download credentials JSON and set path or paste contents
GOOGLE_CALENDAR_CREDENTIALS=

# OpenAI API (optional, for AI-powered matching)
OPENAI_API_KEY=

# Email Configuration (for digests)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

# Scheduling
DISCOVERY_INTERVAL_HOURS=6
DIGEST_CHECK_INTERVAL_MINUTES=60

# Rating Thresholds
AUTO_ADD_THRESHOLD=8.0
DIGEST_THRESHOLD=7.0

# Storage
DATA_DIR=./data
# DATABASE_URL=postgresql://user:pass@localhost/concertmonitor
